{
  "manifest_version": 3,
  "name": "Site Popup Shield",
  "version": "1.1.0",
  "minimum_chrome_version": "119",
  "description": "Choose which websites to protect from unwanted popups and redirect tabs.",
  "permissions": ["activeTab", "storage", "scripting", "declarativeNetRequest", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Site Popup Shield",
    "default_popup": "popup.html"
  }
}
